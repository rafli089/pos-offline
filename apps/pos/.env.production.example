# API base URL for production sync
VITE_API_BASE=https://your-backend.railway.app

# In production, Railway injects CORS_ORIGINS and other env vars.
# Beberapa env VITE_* yang digunakan frontend:
# contoh: VITE_APP_NAME="POS Offline"

# Catatan:
# - Railway menetapkan PORT=4000 dan host=0.0.0.0 untuk container backend.
# - Vercel otomatis menyuntikkan variabel lingkungan dari "Environment Variables" dashboard Vercel.
# - Jangan commit .env files ke repo; gunakan .env.example sebagai template.

# Contoh env yang mungkin digunakan:
# VITE_WS_ENDPOINT=wss://your-backend.railway.app
# VITE_REPORT_EMAIL=noreply@yourdomain.com
